# Copy this file to .env.development for local Docker development.
NODE_ENV=development
PORT=3000
BACKEND_HOST_PORT=3000
DATABASE_URL=postgresql://postgres:replace_with_a_strong_password@database:5432/iot_monitoring?schema=public
TB_BASE_URL=http://thingsboard:8080

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=iot_monitoring
JWT_SECRET=replace_with_a_strong_random_secret
THINGSBOARD_TOKEN=your_actual_device_token

TB_DB_NAME=thingsboard
TB_DB_USER=tbuser
TB_DB_PASSWORD=replace_with_a_strong_password
TB_HTTP_PORT=18080
TB_MQTT_PORT=11883
NGINX_HTTP_PORT=8080

OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
TB_USERNAME=tenant@thingsboard.org
TB_PASSWORD=replace_with_your_thingsboard_password
TB_JWT_TOKEN=
THINGSBOARD_DEVICE_ID=replace_with_thingsboard_device_id
TB_TELEMETRY_KEYS=temperature,humidity,battery
